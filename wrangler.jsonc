{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-seasons",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "routes": [
    { "pattern": "infiniteseasons.com", "custom_domain": true },
    { "pattern": "www.infiniteseasons.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the worker first so it can redirect www before assets are served.
    "run_worker_first": true
  }
}
