{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-seasons",
  "account_id": "3ea5e08a789d4900d99ea3cbe8965e84",
  "compatibility_date": "2026-10-24",
  "routes": [
    { "pattern": "infiniteseasons.com", "custom_domain": true },
    // Kept so www resolves; a zone Redirect Rule sends it to the apex before the Worker runs.
    { "pattern": "www.infiniteseasons.com", "custom_domain": true }
  ],
  // Assets only, no Worker script: static asset requests are free and don't count toward the Workers request limit.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
